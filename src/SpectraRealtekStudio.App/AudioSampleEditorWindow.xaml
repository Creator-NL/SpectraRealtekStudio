<Window x:Class="SpectraRealtekStudio.App.AudioSampleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spectra Sample &amp; Loop Studio — Precision Audio Editor"
        Height="720" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="Background" Value="#1A2140"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263160"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#3D1A52"/>
            <Setter Property="BorderBrush" Value="{StaticResource Magenta}"/>
        </Style>

        <Style x:Key="GreenActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#06120B"/>
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#58FF9E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58FF9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17B85E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyanActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#070A12"/>
            <Setter Property="Background" Value="{StaticResource Cyan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5CF0FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5CF0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14BBD4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NudgeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="Background" Value="#131931"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource Cyan}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,3,24,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#12182E" BorderBrush="{StaticResource Cyan}"
                                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP STUDIO HEADER & LOAD / UNDO / REDO BAR -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#112940" BorderBrush="{StaticResource Cyan}" BorderThickness="1.2"
                            CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock Text="SAMPLE &amp; LOOP STUDIO" Foreground="{StaticResource Cyan}"
                                   FontWeight="Bold" FontSize="11.5"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtTrackTitle" Text="No Track Loaded — Click '📂 Load Any Track...' or select a recording"
                               Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="13.5"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtFormatBadge" Text="Bit-Pure Native Engine Ready (16-bit / 24-bit / 32-bit Float • up to 192 kHz)"
                               Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Live Stereo Output Meter -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0" Width="130">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L" Foreground="{StaticResource Muted}" FontSize="9.5" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="PbEditorPeakL" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Background="#0A0E1C" Foreground="{StaticResource Cyan}" BorderThickness="0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Foreground="{StaticResource Muted}" FontSize="9.5" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="PbEditorPeakR" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Background="#0A0E1C" Foreground="{StaticResource Magenta}" BorderThickness="0"/>
                    </Grid>
                </StackPanel>

                <!-- Load Track & Undo / Redo / Reset -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLoadTrack" Content="📂 Load Any Track..." Style="{StaticResource CyanActionButton}"
                            Padding="12,5" Click="BtnLoadTrack_Click"
                            ToolTip="Open any audio or video track (.wav, .flac, .mp3, .m4a, .aac, .ogg, .wma, .mp4) at 100% original sample rate for editing and looping"/>
                    <Button x:Name="BtnUndo" Content="↶ Undo" IsEnabled="False" Click="BtnUndo_Click"
                            ToolTip="Undo last edit (Ctrl+Z)"/>
                    <Button x:Name="BtnRedo" Content="↷ Redo" IsEnabled="False" Click="BtnRedo_Click"
                            ToolTip="Redo edit (Ctrl+Y)"/>
                    <Button x:Name="BtnResetOriginal" Content="↺ Reset Original" Margin="0" Click="BtnResetOriginal_Click"
                            ToolTip="Restore the full unedited audio from when the file was opened"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: ZOOM, SNAP & QUICK LOOP BAR -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,6,0"/>
                    <Button x:Name="BtnZoomIn" Content="🔍+ In" Padding="8,3" Click="BtnZoomIn_Click" ToolTip="Zoom in around selection/playhead (Mouse Wheel Up)"/>
                    <Button x:Name="BtnZoomOut" Content="🔍- Out" Padding="8,3" Click="BtnZoomOut_Click" ToolTip="Zoom out (Mouse Wheel Down)"/>
                    <Button x:Name="BtnZoomSelection" Content="↔ Fit Loop" Padding="8,3" Click="BtnZoomSelection_Click" ToolTip="Zoom waveform view to fit the selected [IN .. OUT] loop region"/>
                    <Button x:Name="BtnZoomAll" Content="⊞ Fit All" Padding="8,3" Click="BtnZoomAll_Click" ToolTip="Show entire audio file"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scroll:" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="SldZoomScroll" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                            IsEnabled="False" VerticalAlignment="Center" ValueChanged="SldZoomScroll_ValueChanged"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkZeroCrossSnap" Content="Zero-Crossing Snap (Click-Free Loops)"
                              Foreground="{StaticResource Green}" FontWeight="SemiBold" FontSize="11.5"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="ChkZeroCrossSnap_Changed" Unchecked="ChkZeroCrossSnap_Changed"
                              ToolTip="Automatically snaps IN and OUT markers to the nearest 0.0 zero-crossing so loops and cuts never click or pop!"/>

                    <TextBlock Text="Quick Loop:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,6,0"/>
                    <Button Content="÷2" Style="{StaticResource NudgeButton}" Click="BtnHalveLoop_Click" ToolTip="Halve selected loop length"/>
                    <Button Content="×2" Style="{StaticResource NudgeButton}" Click="BtnDoubleLoop_Click" ToolTip="Double selected loop length"/>
                    <Button Content="1s" Style="{StaticResource NudgeButton}" Tag="1.0" Click="BtnQuickLoopSec_Click" ToolTip="Select 1.0 second loop from IN marker"/>
                    <Button Content="2s" Style="{StaticResource NudgeButton}" Tag="2.0" Click="BtnQuickLoopSec_Click" ToolTip="Select 2.0 second loop from IN marker"/>
                    <Button Content="4s" Style="{StaticResource NudgeButton}" Tag="4.0" Click="BtnQuickLoopSec_Click" ToolTip="Select 4.0 second loop from IN marker"/>
                    <Button Content="8s" Style="{StaticResource NudgeButton}" Tag="8.0" Click="BtnQuickLoopSec_Click" ToolTip="Select 8.0 second loop from IN marker"/>
                    <Button Content="All" Style="{StaticResource NudgeButton}" Margin="0" Click="BtnSelectAll_Click" ToolTip="Select entire audio file (Ctrl+A)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: INTERACTIVE 60 FPS STEREO WAVEFORM & LOOP REGION CANVAS -->
        <Border Grid.Row="2" Background="#070A14" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True">
            <Grid x:Name="WaveCanvasHost" SizeChanged="WaveCanvasHost_SizeChanged">
                <Image x:Name="ImgEditorWaveform" Stretch="Fill"
                       Cursor="SizeWE"
                       MouseLeftButtonDown="ImgEditorWaveform_MouseLeftButtonDown"
                       MouseMove="ImgEditorWaveform_MouseMove"
                       MouseLeftButtonUp="ImgEditorWaveform_MouseLeftButtonUp"
                       MouseRightButtonDown="ImgEditorWaveform_MouseRightButtonDown"
                       MouseWheel="ImgEditorWaveform_MouseWheel"/>

                <TextBlock x:Name="TxtWaveOverlayHint"
                           Text="DRAG GREEN [IN] &amp; AMBER [OUT] HANDLES TO SET LOOP OR CUT POINTS • CLICK &amp; DRAG TO SELECT REGION • RIGHT-CLICK TO SEEK • WHEEL TO ZOOM"
                           Foreground="#6680B8" FontFamily="Consolas" FontSize="10.5"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,6"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ROW 3: PRECISION IN (START) & OUT (END) FINE-TUNE CONTROLS -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IN (START) Point Fine-Tune -->
                <Border Grid.Column="0" Background="#0E1428" BorderBrush="#1D4B3A" BorderThickness="1"
                        CornerRadius="5" Padding="9,6" Margin="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶ IN (START / LOOP START):" Foreground="{StaticResource Green}"
                                           FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtInTime" Text="00:00.000" Foreground="#FFFFFF"
                                           FontFamily="Consolas" FontWeight="Bold" FontSize="13.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="[ Set IN at Playhead" HorizontalAlignment="Right"
                                    Style="{StaticResource NudgeButton}" Foreground="{StaticResource Green}"
                                    Margin="0" Click="BtnSetInAtPlayhead_Click"
                                    ToolTip="Set loop/selection Start (IN) to current white playhead position (Shortcut: I)"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fine Tune:" Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="◄ -50ms" Style="{StaticResource NudgeButton}" Tag="-50" Click="BtnNudgeIn_Click"/>
                            <Button Content="◄ -10ms" Style="{StaticResource NudgeButton}" Tag="-10" Click="BtnNudgeIn_Click"/>
                            <Button Content="◄ -1ms" Style="{StaticResource NudgeButton}" Tag="-1" Click="BtnNudgeIn_Click"/>
                            <Button Content="+1ms ►" Style="{StaticResource NudgeButton}" Tag="1" Click="BtnNudgeIn_Click"/>
                            <Button Content="+10ms ►" Style="{StaticResource NudgeButton}" Tag="10" Click="BtnNudgeIn_Click"/>
                            <Button Content="+50ms ►" Style="{StaticResource NudgeButton}" Tag="50" Margin="0" Click="BtnNudgeIn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- OUT (END) Point Fine-Tune -->
                <Border Grid.Column="1" Background="#0E1428" BorderBrush="#553B16" BorderThickness="1"
                        CornerRadius="5" Padding="9,6" Margin="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◀ OUT (END / LOOP END):" Foreground="{StaticResource Amber}"
                                           FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOutTime" Text="00:00.000" Foreground="#FFFFFF"
                                           FontFamily="Consolas" FontWeight="Bold" FontSize="13.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="Set OUT at Playhead ]" HorizontalAlignment="Right"
                                    Style="{StaticResource NudgeButton}" Foreground="{StaticResource Amber}"
                                    Margin="0" Click="BtnSetOutAtPlayhead_Click"
                                    ToolTip="Set loop/selection End (OUT) to current white playhead position (Shortcut: O)"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fine Tune:" Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="◄ -50ms" Style="{StaticResource NudgeButton}" Tag="-50" Click="BtnNudgeOut_Click"/>
                            <Button Content="◄ -10ms" Style="{StaticResource NudgeButton}" Tag="-10" Click="BtnNudgeOut_Click"/>
                            <Button Content="◄ -1ms" Style="{StaticResource NudgeButton}" Tag="-1" Click="BtnNudgeOut_Click"/>
                            <Button Content="+1ms ►" Style="{StaticResource NudgeButton}" Tag="1" Click="BtnNudgeOut_Click"/>
                            <Button Content="+10ms ►" Style="{StaticResource NudgeButton}" Tag="10" Click="BtnNudgeOut_Click"/>
                            <Button Content="+50ms ►" Style="{StaticResource NudgeButton}" Tag="50" Margin="0" Click="BtnNudgeOut_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Selection Duration & Loop Tempo Info -->
                <Border Grid.Column="2" Background="#0E1428" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="5" Padding="12,6" MinWidth="255">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="SELECTED LENGTH:" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSelectedDuration" Text="00:00.000" Foreground="{StaticResource Cyan}"
                                       FontFamily="Consolas" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtLoopBpmEstimate" Text="Playhead: 00:00.000 • Loop BPM: —"
                                   Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 4: AUDITION / LOOP TRANSPORT & NON-DESTRUCTIVE CUT / EDIT TOOLS -->
        <Border Grid.Row="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Transport & Seamless Loop Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button x:Name="BtnLoopSelection" Content="🔁 Loop Selection (OFF)"
                            Style="{StaticResource GreenActionButton}" Padding="13,6"
                            Click="BtnLoopSelection_Click"
                            ToolTip="Continuously loop the selected [IN .. OUT] part with zero gap! Adjust IN/OUT handles live while playing to lock in the perfect loop (Shortcut: Space or L)"/>
                    <Button x:Name="BtnPlaySelectionOnce" Content="▶ Play Selection" Padding="11,6"
                            Click="BtnPlaySelectionOnce_Click"
                            ToolTip="Play the selected [IN .. OUT] region once from IN to OUT"/>
                    <Button x:Name="BtnPlayFull" Content="▶ Play Full" Padding="10,6"
                            Click="BtnPlayFull_Click"
                            ToolTip="Play full track from current playhead"/>
                    <Button x:Name="BtnStop" Content="■ Stop" Padding="10,6"
                            Click="BtnStop_Click"
                            ToolTip="Stop playback"/>
                </StackPanel>

                <!-- Cut Start & End / Delete Middle / Fades / Normalize -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCropStartAndEnd" Content="✂ Cut Start &amp; End (Keep Selection)"
                            Style="{StaticResource CyanActionButton}" Padding="12,6"
                            Click="BtnCropStartAndEnd_Click"
                            ToolTip="Cuts off everything before IN and after OUT, keeping ONLY the selected [IN .. OUT] part"/>
                    <Button x:Name="BtnCutStartOnly" Content="✂ Cut Start (Before IN)" Padding="9,6"
                            Click="BtnCutStartOnly_Click"
                            ToolTip="Trims off only the beginning of the track before the green IN marker"/>
                    <Button x:Name="BtnCutEndOnly" Content="✂ Cut End (After OUT)" Padding="9,6"
                            Click="BtnCutEndOnly_Click"
                            ToolTip="Trims off only the ending of the track after the amber OUT marker"/>
                    <Button x:Name="BtnDeleteMiddle" Content="🗑 Cut Selected Middle" Padding="9,6"
                            Click="BtnDeleteMiddle_Click"
                            ToolTip="Deletes the selected [IN .. OUT] middle section and smoothly joins the outer ends"/>
                    <Button x:Name="BtnFadeIn" Content="◢ Fade In" Padding="8,6"
                            Click="BtnFadeIn_Click"
                            ToolTip="Applies a smooth studio fade-in to the selected region (or start of track)"/>
                    <Button x:Name="BtnFadeOut" Content="◣ Fade Out" Padding="8,6"
                            Click="BtnFadeOut_Click"
                            ToolTip="Applies a smooth studio fade-out to the selected region (or end of track)"/>
                    <Button x:Name="BtnNormalize" Content="⚡ Normalize" Padding="8,6" Margin="0"
                            Click="BtnNormalize_Click"
                            ToolTip="Normalizes peak volume of the selected region to -0.2 dBFS"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 5: SAVE SELECTED LOOP / PART OR FULL EDITED FILE BAR -->
        <Border Grid.Row="5" Background="#10172B" BorderBrush="{StaticResource Cyan}"
                BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtEditorStatus"
                               Text="Ready — Select a region and click '🔁 Loop Selection' to audition your loop, or '✂ Cut Start &amp; End' to trim."
                               Foreground="{StaticResource Cyan}" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Save Format:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbSaveBitFormat" Width="156" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ComboBoxItem Content="16-bit PCM (CD)"/>
                        <ComboBoxItem Content="24-bit PCM (Studio)" IsSelected="True"/>
                        <ComboBoxItem Content="32-bit IEEE Float"/>
                    </ComboBox>

                    <Button x:Name="BtnSaveSelectedLoopAs" Content="💾 Save Selected Loop / Part As..."
                            Style="{StaticResource GreenActionButton}" Padding="13,6"
                            Click="BtnSaveSelectedLoopAs_Click"
                            ToolTip="Saves ONLY the selected [IN .. OUT] loop / audio part directly to a lossless WAV file at original sample rate!"/>

                    <Button x:Name="BtnSaveFullTrackAs" Content="💾 Save Full Edited Audio As..."
                            Style="{StaticResource CyanActionButton}" Padding="12,6"
                            Click="BtnSaveFullTrackAs_Click"
                            ToolTip="Saves the full edited audio buffer to a new WAV file"/>

                    <Button x:Name="BtnOverwriteCurrentWav" Content="💾 Overwrite Current WAV"
                            Style="{StaticResource AccentButton}" Padding="11,6"
                            Click="BtnOverwriteCurrentWav_Click"
                            ToolTip="Overwrites the current recording file on disk with your edited audio"/>

                    <Button Content="Close" Margin="0" Padding="12,6" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
