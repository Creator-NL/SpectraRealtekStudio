<Application x:Class="SpectraRealtekStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Spectra Theme Palette -->
        <SolidColorBrush x:Key="Bg" Color="#0B0D14"/>
        <SolidColorBrush x:Key="Panel" Color="#121626"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#161B30"/>
        <SolidColorBrush x:Key="CardBg" Color="#151A2E"/>
        <SolidColorBrush x:Key="Line" Color="#243055"/>
        <SolidColorBrush x:Key="Cyan" Color="#22E8FF"/>
        <SolidColorBrush x:Key="Magenta" Color="#FF2BD6"/>
        <SolidColorBrush x:Key="Green" Color="#22E87A"/>
        <SolidColorBrush x:Key="Text" Color="#D7E3FF"/>
        <SolidColorBrush x:Key="Muted" Color="#7F8BB0"/>
        <SolidColorBrush x:Key="Selected" Color="#2A1F4D"/>
        <SolidColorBrush x:Key="Amber" Color="#FFB020"/>
    </Application.Resources>
</Application>
